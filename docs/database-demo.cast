[7.64, "o", "\u001b[15;7Hdatabase\u001b[15;15H"]
[10.109, "o", "\u001b[15;15H"]
[10.109, "o", "\r\n"]
[10.109, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe - database\u001b\\"]
[10.265, "o", "***База данных***\r\n"]
[10.265, "o", "\r\n***Операции с данными***\r\n\r\nФункции:"]
[10.265, "o", "\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n"]
[10.265, "o", "<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n"]
[10.265, "o", "\r\nУправление таблицами:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:"]
[10.281, "o", "\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\nУдаление таблиц и записей требует подтверждения: y — выполнить, иначе отмена.\r\n\r\n"]
[10.281, "o", ">>>Введите команду: "]
[16.14, "o", "\u001b[36;21Hhelp\u001b[36;25H"]
[17.968, "o", "\u001b[36;25H"]
[17.968, "o", "\r\n"]
[17.968, "o", "\r\n***Операции с данными***\r\n"]
[17.968, "o", "\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n"]
[17.968, "o", "<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n"]
[17.968, "o", "<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n\r\nУправление таблицами:\r\n"]
[17.968, "o", "<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:\r\n"]
[17.968, "o", "<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\nУдаление таблиц и записей требует подтверждения: y — выполнить, иначе отмена.\r\n\r\n"]
[17.968, "o", ">>>Введите команду: "]
[24.14, "o", "\u001b[36;21Hcreate_table users name:str age:int is_active:bool\u001b[36;71H"]
[26.296, "o", "\u001b[36;71H"]
