[10.906, "o", "***База данных***\r\n"]
[10.906, "o", "\r\n***Операции с данными***\r\n\r\nФункции:"]
[10.906, "o", "\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n"]
[10.922, "o", "<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n\r\nУправление таблицами:\r\n"]
[10.922, "o", "<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:\r\n"]
[10.922, "o", "<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[10.922, "o", ">>>Введите команду: "]
[16.781, "o", "\u001b[32;21Hcreate_table users name:str age:int is_active:bool\u001b[32;71H"]
[18.609, "o", "\u001b[32;71H"]
[18.609, "o", "\r\n"]
[18.609, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[18.609, "o", ">>>Введите команду: "]
[22.781, "o", "\u001b[32;21Hinsert into users values (\"Sergei\", 28, true)\u001b[32;66H"]
[24.937, "o", "\u001b[32;66H"]
[24.937, "o", "\r\n"]
[24.937, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[24.937, "o", ">>>Введите команду: "]
[29.203, "o", "\u001b[32;21Hselect from users\u001b[32;38H"]
[31.359, "o", "\u001b[32;38H"]
[31.359, "o", "\r\n"]
[31.656, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[31.656, "o", "\r\n"]
[31.656, "o", ">>>Введите команду: "]
[36.906, "o", "\u001b[32;21Hselect from users where age = 28\u001b[32;53H"]
[39.266, "o", "\u001b[32;53H"]
[39.266, "o", "\r\n"]
[39.266, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[39.281, "o", "\r\n"]
[39.281, "o", ">>>Введите команду: "]
[44.531, "o", "\u001b[32;21Hupdate users set age = 29 where name = \"Sergei\"\u001b[32;68H"]
[46.719, "o", "\u001b[32;68H"]
[46.719, "o", "\r\n"]
[46.719, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[46.719, "o", ">>>Введите команду: "]
[50.656, "o", "\u001b[32;21Hselect from users where ID = 1\u001b[32;51H"]
[52.875, "o", "\u001b[32;51H"]
[52.875, "o", "\r\n"]
[52.891, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+"]
[52.891, "o", "\r\n"]
[52.891, "o", ">>>Введите команду: "]
[57.75, "o", "\u001b[32;21Hexit\u001b[32;25H"]
[60.172, "o", "\u001b[32;25H"]
[60.172, "o", "\r\n"]
[60.187, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe\u001b\\"]
[60.187, "o", "\r\n"]
[60.187, "o", "DEMO> "]
[63.75, "o", "\u001b[32;7Hdatabase\u001b[32;15H"]
[66.172, "o", "\u001b[32;15H"]
[66.172, "o", "\r\n"]
[66.172, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe - database\u001b\\"]
[66.312, "o", "***База данных***\r\n"]
[66.312, "o", "\r\n***Операции с данными***\r\n\r\nФункции:"]
[66.312, "o", "\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n"]
[66.312, "o", "<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n\r\nУправление таблицами:"]
[66.312, "o", "\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n"]
[66.312, "o", "\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[66.312, "o", ">>>Введите команду: "]
[70.531, "o", "\u001b[32;21Hselect from users\u001b[32;38H"]
[72.812, "o", "\u001b[32;38H"]
[72.812, "o", "\r\n"]
[72.875, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+"]
[72.875, "o", "\r\n"]
[72.875, "o", ">>>Введите команду: "]
[77.797, "o", "\u001b[32;21Hdelete from users where ID = 1\u001b[32;51H"]
[79.656, "o", "\u001b[32;51H"]
[79.656, "o", "\r\n"]
[79.656, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[79.656, "o", ">>>Введите команду: "]
[84.047, "o", "\u001b[32;21Hinsert into users values (\"Bad\", \"28\", true)\u001b[32;65H"]
[86.578, "o", "\u001b[32;65H"]
[86.578, "o", "\r\n"]
[86.578, "o", "Ошибка: Столбец \"age\" должен иметь тип int.\r\n"]
[86.578, "o", ">>>Введите команду: "]
[90.859, "o", "\u001b[32;21Hinfo users\u001b[32;31H"]
[93.469, "o", "\u001b[32;31H"]
[93.469, "o", "\r\n"]
[93.469, "o", "Таблица: users\r\n"]
[93.469, "o", "Столбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 0\r\n"]
[93.469, "o", ">>>Введите команду: "]
[98.578, "o", "\u001b[32;21Hexit\u001b[32;25H"]
[100.266, "o", "\u001b[32;25H"]
[100.266, "o", "\r\n"]
[100.266, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe\u001b\\"]
[100.266, "o", "\r\n"]
