[41.297, "o", "***База данных***\r\n"]
[41.297, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n"]
[41.297, "o", "\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n"]
[41.297, "o", "<command> help - справочная информация\r\n\r\n"]
[41.297, "o", ">>>Введите команду: "]
[45.25, "o", "\u001b[32;21Hlist_tables\u001b[32;32H"]
[47.453, "o", "\u001b[32;32H"]
[47.469, "o", "\r\n"]
[47.469, "o", "- users\r\n"]
[47.469, "o", ">>>Введите команду: "]
[50.828, "o", "\u001b[32;21Hdrop_table users\u001b[32;37H"]
[53.25, "o", "\u001b[32;37H"]
[53.25, "o", "\r\n"]
[53.25, "o", "Таблица \"users\" успешно удалена.\r\n"]
[53.25, "o", ">>>Введите команду: "]
