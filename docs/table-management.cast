[59.234, "o", "\u001b[32;32H"]
[59.234, "o", "\r\n"]
[59.25, "o", "Таблиц пока нет.\r\n"]
[59.25, "o", ">>>Введите команду: "]
[62.953, "o", "\u001b[32;21Hdrop_table products\u001b[32;40H"]
