[7.656, "o", "\u001b[13;7Hdatabase\u001b[13;15H"]
[10.109, "o", "\u001b[13;15H"]
[10.109, "o", "\r\n"]
[10.109, "o", "\u001b]0;C:\\WINDOWS\\system32\\cmd.exe - database\u001b\\"]
[10.219, "o", "***База данных***\r\n"]
[10.219, "o", "\r\n***Процесс работы с таблицей***\r\n"]
[10.219, "o", "Функции:\r\n"]
[10.219, "o", "<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n"]
[10.219, "o", "<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n"]
[10.219, "o", "<command> help - справочная информация\r\n\r\n"]
[10.219, "o", ">>>Введите команду: "]
[15.078, "o", "\u001b[26;21Hcreate_table users name:str age:int is_active:bool\u001b[26;71H"]
[16.906, "o", "\u001b[26;71H"]
[16.906, "o", "\r\n"]
[16.906, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[16.906, "o", ">>>Введите команду: "]
[21.078, "o", "\u001b[28;21Hcreate_table users name:str\u001b[28;48H"]
